Output docs/demos/help.gif
Output docs/demos/help.mp4
Set Shell "bash"
Set WaitTimeout 5m
Set FontFamily "Menlo"
Set FontSize 18
Set Width 1200
Set Height 760
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 65ms
Set Framerate 20
Hide
Type@1ms "unset NO_COLOR; export TERM=xterm-256color COLORTERM=truecolor; export PS1='$ '; export PATH=$PWD/bin:$PATH; clear"
Enter
Sleep 500ms
Show
Type "yz --help"
Enter
Sleep 8s
